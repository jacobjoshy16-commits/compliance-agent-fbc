"""
change_control.py — MOCKUP. Emits a ready-to-paste revision entry + routing.

Rationale: a proposed amendment that doesn't slot into the document's existing
change-control process is just text. Both target documents already define how
they get changed, and they define it DIFFERENTLY:

  FBC AI Policy  -> a revision table:
                    Change Initiator | Management Approver | Summary of Changes
                                     | Date | Revision Number
                    (Emmanuel Effiong | Lee Morgan | Initial Version
                                     | 10/31/2025 | 1.0)

  FBC Policy 604 -> "Policy Approved and Adopted by: Fort Bend County
                    Commissioners Court", then a flat list of "Revised: <date>".

So the emitter detects the format and matches it. Nothing here is generated by
the model -- the summary is ASSEMBLED from finding metadata, same principle as
the citation allowlist. A revision log is a record. It does not get to be
approximately true.

STATUS: mockup. Detection + version logic are tested; the rendered output is
still to be reviewed against a real amendment before anyone relies on it.
"""

import re
from collections import Counter
from datetime import date

# --- Approval routing ------------------------------------------------------
# Who a change actually has to go to. Read straight out of each document.
ROUTING = {
    "ai_policy": (
        "Emerging Technologies Committee (ETC) → Management Approver of record "
        "(per the document's Revision History). Per 'Decision Rights and "
        "Escalation', moderate- to high-risk changes additionally require Change "
        "Control Board (CCB) review, and policy variances require ratification by "
        "Commissioners Court."
    ),
    "policy_604": (
        "Fort Bend County Commissioners Court — the document states 'Policy "
        "Approved and Adopted by: Fort Bend County Commissioners Court'. Route "
        "through the IT Director and Human Resources before the Court agenda. "
        "This is NOT a management-level change."
    ),
    "unknown": (
        "Change-control process not detected in this document. Identify the "
        "approving authority before circulating."
    ),
}

REV_TABLE = re.compile(r'Change\s+Initiator', re.I)
REV_LIST = re.compile(r'Approved\s+and\s+Adopted\s+by|^\s*Revised:\s', re.I | re.M)
REV_NUM = re.compile(r'\b(\d+)\.(\d+)\b')
REVISED_DATE = re.compile(r'Revised:\s*([A-Z][a-z]+\s+\d{1,2},\s*\d{4})')


def detect_document(text):
    """Which of the county's two change-control styles is this?"""
    head = text[:2000]
    if re.search(r'Artificial\s+Intelligence\s+Policy', head, re.I):
        return "ai_policy"
    if re.search(r'ACCEPTABLE\s+USE\s+OF\s+INFORMATION\s+SYSTEMS|604\.\d{2}', text, re.I):
        return "policy_604"
    return "unknown"


def detect_format(text):
    if REV_TABLE.search(text):
        return "table"
    if REV_LIST.search(text):
        return "list"
    return "unknown"


def current_revision(text):
    """
    Last revision number (table style) or last revised date (list style).
    Returns (kind, value) — ('rev', '1.0') or ('date', 'June 7, 2022').
    """
    if detect_format(text) == "table":
        tail = text[-1500:]
        nums = REV_NUM.findall(tail)
        if nums:
            major, minor = nums[-1]
            return "rev", f"{major}.{minor}"
        return "rev", "1.0"
    dates = REVISED_DATE.findall(text)
    if dates:
        return "date", dates[-1]
    return "date", "unknown"


def bump(rev, level="minor"):
    """
    Version bump. Default minor: adding control language to an existing policy
    is not a rewrite. Caller overrides for major.
    """
    try:
        major, minor = (int(x) for x in rev.split("."))
    except (ValueError, AttributeError):
        return "1.1"
    return f"{major + 1}.0" if level == "major" else f"{major}.{minor + 1}"


def summarize(drafts):
    """
    Summary of Changes — ASSEMBLED, not generated.

    A revision log is a record of what changed. It does not get to be
    approximately true, so no model touches this string.
    """
    if not drafts:
        return "No changes."
    procs = sorted({d["process_id"] for d in drafts})
    fams = Counter(d["family"] for d in drafts)
    ctrls = sorted({d["control_id"] for d in drafts})
    risks = Counter(d["risk"] for d in drafts)

    fam_txt = ", ".join(f"{k} ({v})" for k, v in fams.most_common())
    risk_txt = ", ".join(f"{v} {k.lower()}" for k, v in risks.most_common())
    return (
        f"Added policy language addressing {len(drafts)} identified gap(s) "
        f"[{risk_txt}] across {len(procs)} section(s): {', '.join(procs)}. "
        f"Controls referenced: {', '.join(ctrls)}. Control families: {fam_txt}. "
        f"Gaps identified by automated review; language drafted with AI assistance "
        f"and validated by the Change Initiator prior to submission."
    )


def revision_entry(drafts, target_text, initiator, approver,
                   effective=None, level="minor"):
    """Returns a dict containing a ready-to-paste entry in the document's own format."""
    doc = detect_document(target_text)
    fmt = detect_format(target_text)
    kind, cur = current_revision(target_text)
    eff = effective or date.today().strftime("%m/%d/%Y")
    summary = summarize(drafts)

    if fmt == "table":
        new_rev = bump(cur, level)
        row = f"| {initiator} | {approver} | {summary} | {eff} | {new_rev} |"
        header = ("| Change Initiator | Management Approver | Summary of Changes "
                  "| Date | Revision Number |\n|---|---|---|---|---|")
        paste = f"{header}\n{row}"
    elif fmt == "list":
        new_rev = None
        # NOTE: "%-d" is not portable (fails on Windows). Build it manually.
        today = date.today()
        long_date = (f"{today.strftime('%B')} {today.day}, {today.year}"
                     if effective is None else effective)
        paste = (f"Revised: {long_date}\n\n"
                 f"(Summary for the agenda item — this document's revision list "
                 f"carries dates only:)\n{summary}")
    else:
        new_rev = None
        paste = summary

    return {
        "document": doc,
        "format": fmt,
        "current": cur,
        "current_kind": kind,
        "new_revision": new_rev,
        "effective": eff,
        "initiator": initiator,
        "approver": approver,
        "summary": summary,
        "paste_block": paste,
        "routing": ROUTING[doc],
        "status": "DRAFT — requires Change Initiator sign-off before submission",
    }


def render_markdown(entry):
    L = [
        "## Change Control Entry",
        "",
        f"**Detected document:** `{entry['document']}`  |  "
        f"**Revision format:** `{entry['format']}`",
        "",
        f"**Current:** {entry['current']}"
        + (f"  →  **Proposed:** {entry['new_revision']}" if entry["new_revision"] else ""),
        "",
        "**Ready to paste into the document's revision history:**",
        "",
        "```",
        entry["paste_block"],
        "```",
        "",
        f"**Approval routing:** {entry['routing']}",
        "",
        f"> {entry['status']}. The Change Initiator ({entry['initiator']}) is "
        f"accountable for the accuracy of this entry — not the tool.",
    ]
    return "\n".join(L)